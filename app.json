{
  "expo": {
    "name": "Lumityot",
    "slug": "Lumiwork",
    "scheme": "lumityot",
    "version": "2.6.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "buildNumber": "16",
      "bundleIdentifier": "com.senseitechh.Lumiwork",
      "infoPlist": {
        "CFBundleDisplayName": "Lumityöt",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.senseitechh.Lumiwork",
      "versionCode": 14
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ae040a3f-e178-4831-b486-7415e1a8e042"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      "./plugins/withAndroidDisplayName",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sijaintiasi käytetään tilauksen osoitteen löytämiseen.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "locationFullAccuracyPermission": false
        }
      ]
    ]
  }
}
